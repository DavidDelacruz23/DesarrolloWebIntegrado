<?xml version="1.0" encoding="UTF-8"?>
<!--
    Este pom.xml refleja lo que deberías obtener al generar el proyecto
    en https://start.spring.io con estas opciones:
      - Project: Maven
      - Language: Java
      - Spring Boot: 3.3.x (o la última estable)
      - Group: com.vetcitas
      - Artifact: gestion
      - Packaging: Jar
      - Java: 17

    Dependencias (Add Dependencies) a marcar en el Initializr:
      - Spring Web
      - Spring Data JPA
      - MySQL Driver
      - Spring Security   (solo se usa para el bean de BCrypt en este entregable)
      - Validation
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>com.vetcitas</groupId>
    <artifactId>gestion</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>gestion-citas-veterinarias</name>
    <description>Sistema de Gestion de Citas Veterinarias - Modulo de Autenticacion</description>

    <properties>
        <java.version>17</java.version>
    </properties>

    <dependencies>
        <!-- Permite crear controladores REST (@RestController, @GetMapping, etc.) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Spring Data JPA: repositorios, entidades, Hibernate como implementacion de JPA -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Solo se usa para obtener PasswordEncoder / BCrypt en este entregable -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- Bean Validation: @NotBlank, @Email, @Size en los DTOs -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Driver JDBC para conectar con MySQL -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Utilidades para pruebas (JUnit, Mockito, etc.) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
